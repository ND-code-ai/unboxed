{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "schema": "cd .. && uv run python -m shopper.api.schema web/lib/api/openapi.json",
    "types": "openapi-typescript lib/api/openapi.json -o lib/api/schema.d.ts",
    "generate": "npm run schema && npm run types"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}

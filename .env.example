# Copy to .env and fill in. Names and the task that first needs each one are listed in
# docs/building_the_project.md ("Environment variables").
NEBIUS_TOKEN_FACTORY=
# Override a tier's model; the default in config.py when empty. Nebius retires the small and medium
# defaults on 9 November 2026 (docs/architecture/models.md, "Tiers")
NEBIUS_MODEL_SMALL=
NEBIUS_MODEL_MEDIUM=
NEBIUS_MODEL_LARGE=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# live (the default) or fixtures
SHOPPER_SOURCES=
# real (the default) or stubs: the API on the stub agents, so a run spends one supervisor call
SHOPPER_AGENTS=
# Tavily credits per day; 100 when empty
TAVILY_DAILY_CREDIT_LIMIT=
# true traces a terminal-app run, or each run of the API, in LangSmith (an EU-region org's key);
# off when empty
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
# true-cost-copilot when empty
LANGSMITH_PROJECT=
# The origins whose pages may call the API, comma-separated; http://localhost:3000 when empty
FRONTEND_ORIGINS=
# A Postgres database for the API's sessions; the SQLite file .cache/sessions.sqlite when empty
DATABASE_URL=
# The sessions one client IP may start in an hour; 30 when empty
SESSIONS_PER_IP_PER_HOUR=
# The sessions all clients together may start in 24 hours; 100 when empty
SESSIONS_PER_DAY=
# The proxies in front of the API that append to X-Forwarded-For; 0 (none) when empty
TRUSTED_PROXY_HOPS=
